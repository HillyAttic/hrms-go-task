rules_version = '2';

// Firebase Storage Security Rules
//
// Every path here is used by the client SDK (firebase/storage). Uploads that go through
// the Admin SDK — e.g. profile photos in src/app/api/auth/profile/route.ts — bypass these
// rules entirely and need no entry. Keep this list in sync with the `storagePath` values
// in src/services/employee-document.service.ts, src/services/form-file-upload.service.ts
// and src/lib/task-attachment.service.ts.
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == 'admin';
    }

    // Helper function to check if user is manager or admin
    function isManager() {
      return request.auth != null &&
             (request.auth.token.role == 'admin' ||
              request.auth.token.role == 'manager');
    }

    // Form submissions - allow authenticated users to upload files
    match /forms/{formId}/{submissionId}/{fieldId}/{fileName} {
      // Allow authenticated users to upload files for form submissions
      allow create: if isAuthenticated() &&
                      request.resource.size < 10 * 1024 * 1024; // Max 10MB

      // Allow authenticated users to read files
      allow read: if isAuthenticated();

      // Only admins can delete files
      allow delete: if isAdmin();
    }

    // Profile pictures
    match /profile-pictures/{userId}/{fileName} {
      // Users can upload their own profile picture
      allow create, update: if isAuthenticated() &&
                              request.auth.uid == userId &&
                              request.resource.size < 5 * 1024 * 1024; // Max 5MB

      // Anyone authenticated can read profile pictures
      allow read: if isAuthenticated();

      // Users can delete their own profile picture, admins can delete any
      allow delete: if isAuthenticated() &&
                      (request.auth.uid == userId || isAdmin());
    }

    // Client documents
    match /client-documents/{clientId}/{fileName} {
      // Managers can upload client documents
      allow create, update: if isManager() &&
                              request.resource.size < 20 * 1024 * 1024; // Max 20MB

      // All authenticated users can read client documents
      allow read: if isAuthenticated();

      // Only managers can delete client documents
      allow delete: if isManager();
    }

    // Employee documents (Aadhaar, PAN, cheques...). An employee may only touch their
    // own folder; managers and admins may touch anyone's.
    match /employees/{employeeId}/documents/{fieldName}/{fileName} {
      allow create, update: if isAuthenticated() &&
                              (request.auth.uid == employeeId || isManager()) &&
                              request.resource.size < 10 * 1024 * 1024; // Max 10MB

      allow read: if isAuthenticated() &&
                     (request.auth.uid == employeeId || isManager());

      allow delete: if isAuthenticated() &&
                       (request.auth.uid == employeeId || isManager());
    }

    // Task and task-comment attachments. Access is scoped by task, which these rules
    // cannot see (it lives in Firestore), so any signed-in user may read and attach.
    // Who may delete a given attachment is decided by the task API before it calls
    // deleteTaskAttachment — see src/app/api/tasks/[id]/route.ts.
    match /task-attachments/{taskId}/{fileName} {
      allow create, update: if isAuthenticated() &&
                              request.resource.size < 25 * 1024 * 1024; // Max 25MB
      allow read, delete: if isAuthenticated();
    }

    match /task-comments/{taskId}/{fileName} {
      allow create, update: if isAuthenticated() &&
                              request.resource.size < 25 * 1024 * 1024; // Max 25MB
      allow read, delete: if isAuthenticated();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
